# GEMINI_API_KEY: Required for server-side Interaction Analytics Playground calls.
# Configure this in your AI Studio Secrets panel or Vercel Environment Variables.
GEMINI_API_KEY=

# APP_URL: Canonical base URL for SEO and deployment references.
APP_URL=https://ai-business-growth-lab.vercel.app

# CONTACT FORM EMAIL DELIVERY VIA RESEND (Server-side only)
# Recipient inbox for all website enquiries
CONTACT_RECIPIENT_EMAIL=team.aigrowthlab@gmail.com

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in Resend (e.g. "AI Growth Lab <no-reply@yourdomain.com>")
RESEND_FROM=
